{
  "name": "dc632c03-3fd0-5082-87c9-a46f03a47a23",
  "displayName": "Collect Incident Details",
  "form": {
    "parameters": [
      {
        "displayName": "incident_type",
        "required": true,
        "entityType": "@incident_type",
        "fillBehavior": {
          "initialPromptFulfillment": {
            "messages": [
              {
                "text": {
                  "text": [
                    "What kind of issue is it? For example: water leak, energy waste (like lights or air-con left on), recycling contamination, hazardous spill, or an accessibility barrier."
                  ]
                },
                "languageCode": "en"
              },
              {
                "payload": {
                  "richContent": [
                    [
                      {
                        "type": "chips",
                        "options": [
                          {
                            "text": "Water leak"
                          },
                          {
                            "text": "Energy waste"
                          },
                          {
                            "text": "Recycling contamination"
                          },
                          {
                            "text": "Hazardous spill"
                          },
                          {
                            "text": "Accessibility barrier"
                          }
                        ]
                      }
                    ]
                  ]
                },
                "languageCode": "en"
              }
            ]
          },
          "repromptEventHandlers": [
            {
              "event": "sys.no-match-1",
              "triggerFulfillment": {
                "messages": [
                  {
                    "text": {
                      "text": [
                        "Sorry, I didn't catch the type of issue. Which is closest: water leak, energy waste, recycling contamination, hazardous spill, or accessibility barrier?"
                      ]
                    },
                    "languageCode": "en"
                  }
                ]
              },
              "name": "7d23f300-698d-5a01-9ef5-c650565d10f8"
            },
            {
              "event": "sys.no-match-2",
              "triggerFulfillment": {
                "messages": [
                  {
                    "text": {
                      "text": [
                        "Let's try once more. You can type one of the options or tap a button."
                      ]
                    },
                    "languageCode": "en"
                  }
                ]
              },
              "name": "2fe421f0-9196-58ee-be89-153481a7ef7f"
            },
            {
              "event": "sys.no-match-3",
              "triggerFulfillment": {
                "messages": [
                  {
                    "text": {
                      "text": [
                        "I'm having trouble understanding, so I'll pass you to a person to make sure nothing is missed."
                      ]
                    },
                    "languageCode": "en"
                  }
                ]
              },
              "targetFlow": "Human Handoff",
              "name": "6994d16f-8cb7-5775-bdc7-023e25040f8c"
            },
            {
              "event": "sys.no-input-default",
              "triggerFulfillment": {
                "messages": [
                  {
                    "text": {
                      "text": [
                        "Take your time. When you're ready, tell me the type of issue."
                      ]
                    },
                    "languageCode": "en"
                  }
                ]
              },
              "name": "d474d9b3-0bc1-5628-ac41-8c15a6fe46c6"
            }
          ]
        }
      },
      {
        "displayName": "building",
        "required": true,
        "entityType": "@building",
        "fillBehavior": {
          "initialPromptFulfillment": {
            "messages": [
              {
                "text": {
                  "text": [
                    "Which building or site is it in? For example: Building C, Main Building, Warehouse or Car Park."
                  ]
                },
                "languageCode": "en"
              },
              {
                "payload": {
                  "richContent": [
                    [
                      {
                        "type": "chips",
                        "options": [
                          {
                            "text": "Building A"
                          },
                          {
                            "text": "Building B"
                          },
                          {
                            "text": "Building C"
                          },
                          {
                            "text": "Building D"
                          },
                          {
                            "text": "Main Building"
                          },
                          {
                            "text": "Warehouse"
                          },
                          {
                            "text": "Car Park"
                          }
                        ]
